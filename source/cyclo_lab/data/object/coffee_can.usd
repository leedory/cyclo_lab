    def "Looks"
    {
        def Material "black"
        {
            token outputs:surface.connect = </CoffeeCan/Looks/black/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </CoffeeCan/Looks/black/AlbedoTexture.outputs:rgb>
                float inputs:metallic = 0.03
                float inputs:roughness = 0.42
                token outputs:surface
            }

            def Shader "AlbedoTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @texture/coffee_can/black_common_uv.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </CoffeeCan/Looks/black/PrimvarReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                color3f outputs:rgb
            }

            def Shader "PrimvarReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
        }

